// admin-contact-service — schema PostgreSQL "contact" (Sprint 4)
// Classe du CDC (4.2) : ContactMessage (+ Notification pour la reponse admin).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTACT_DATABASE_URL")
}

/// Categories du CDC 2.6.
enum TicketCategory {
  ERRATUM
  PEDAGOGICAL_QUESTION
  TECHNICAL_ISSUE
  BOOK_SUGGESTION
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model ContactMessage {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  category        TicketCategory
  targetEntityRef String?        /// ex. EXO-MP-MATH-204 (pre-rempli)
  messageBody     String
  status          TicketStatus   @default(OPEN)
  adminReply      String?
  repliedBy       String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  resolvedAt      DateTime?
  notifications   Notification[]

  @@index([userId])
  @@index([status])
  @@map("contact_messages")
}

model Notification {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  ticketId  String         @db.Uuid
  message   String
  readAt    DateTime?
  createdAt DateTime       @default(now())
  ticket    ContactMessage @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}
