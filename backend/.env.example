# Copier ce fichier en .env puis remplir les secrets.
# Une seule base PostgreSQL, un schema logique par microservice (CDC 3.1).
AUTH_DATABASE_URL=postgresql://nexora:nexora_local@127.0.0.1:5434/nexora?schema=auth
CATALOG_DATABASE_URL=postgresql://nexora:nexora_local@127.0.0.1:5434/nexora?schema=catalog
EXAM_DATABASE_URL=postgresql://nexora:nexora_local@127.0.0.1:5434/nexora?schema=exam
ANALYTICS_DATABASE_URL=postgresql://nexora:nexora_local@127.0.0.1:5434/nexora?schema=analytics
CONTACT_DATABASE_URL=postgresql://nexora:nexora_local@127.0.0.1:5434/nexora?schema=contact
QCM_DATABASE_URL=postgresql://nexora:nexora_local@127.0.0.1:5434/nexora?schema=qcm

REDIS_URL=redis://127.0.0.1:6379

# Secrets JWT (generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=
# Secret partage gateway -> services (les services refusent les requetes sans ce secret)
INTERNAL_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Origine autorisee (frontend Next.js)
CORS_ORIGIN=http://localhost:3000

# Ports
GATEWAY_PORT=4000
AUTH_PORT=4001
CATALOG_PORT=4002
EXAM_PORT=4003
ANALYTICS_PORT=4004
CONTACT_PORT=4005
QCM_PORT=4006
